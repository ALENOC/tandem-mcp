--- /dev/null
+++ b/index.html
@@ -0,0 +1,473 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Orbital Particle Simulation</title>
+<style>
+* { margin: 0; padding: 0; box-sizing: border-box; }
+html, body { width: 100%; height: 100%; overflow: hidden; background: #060913; }
+canvas#sky { display: block; width: 100vw; height: 100vh; }
+#hud {
+  position: fixed;
+  top: 16px;
+  left: 16px;
+  width: 248px;
+  background: rgba(18, 28, 54, 0.42);
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+  border: 1px solid rgba(140, 180, 255, 0.22);
+  border-radius: 14px;
+  padding: 16px;
+  font-family: 'Segoe UI', system-ui, sans-serif;
+  color: #c8d8f8;
+  z-index: 10;
+}
+#hud h2 {
+  font-size: 11px;
+  text-transform: uppercase;
+  letter-spacing: 2.5px;
+  color: rgba(160, 190, 255, 0.7);
+  margin-bottom: 12px;
+}
+.btn-row {
+  display: flex;
+  gap: 6px;
+  margin-bottom: 12px;
+}
+.btn-row button {
+  flex: 1;
+  padding: 6px 4px;
+  font-size: 11px;
+  white-space: nowrap;
+  background: rgba(100, 140, 220, 0.15);
+  border: 1px solid rgba(140, 180, 255, 0.3);
+  border-radius: 6px;
+  color: #c8d8f8;
+  cursor: pointer;
+  transition: background 0.2s;
+}
+.btn-row button:hover {
+  background: rgba(100, 140, 220, 0.3);
+}
+.slider-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 12px;
+}
+.slider-row label {
+  font-size: 11px;
+  white-space: nowrap;
+}
+.slider-row input[type="range"] {
+  flex: 1;
+  height: 4px;
+  -webkit-appearance: none;
+  appearance: none;
+  background: rgba(100, 140, 220, 0.3);
+  border-radius: 2px;
+  outline: none;
+}
+.slider-row input[type="range"]::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  background: #7ba4ff;
+  cursor: pointer;
+}
+#speedVal {
+  font-size: 11px;
+  min-width: 32px;
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+.readouts {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 6px 12px;
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+}
+.readouts span {
+  color: rgba(160, 190, 255, 0.6);
+}
+.readouts b {
+  color: #e0eaff;
+  font-weight: 500;
+}
+</style>
+</head>
+<body>
+<canvas id="sky"></canvas>
+<div id="hud">
+  <h2>Orbital Sim</h2>
+  <div class="btn-row">
+    <button id="btnPlay">Pause</button>
+    <button id="btnTrails">Trails ON</button>
+    <button id="btnReset">Reset</button>
+  </div>
+  <div class="slider-row">
+    <label>Speed</label>
+    <input type="range" id="speed" min="0.2" max="3.0" step="0.1" value="1.0">
+    <span id="speedVal">1.0x</span>
+  </div>
+  <div class="readouts">
+    <span>FPS</span><b id="fps">0</b>
+    <span>Time</span><b id="simTime">0.0 s</b>
+    <span>Bursts</span><b id="bursts">0</b>
+  </div>
+</div>
+<script>
+(function () {
+  var canvas = document.getElementById('sky');
+  var ctx = canvas.getContext('2d');
+  var W = 0, H = 0, scale = 1;
+
+  function resize() {
+    var dpr = window.devicePixelRatio || 1;
+    W = window.innerWidth;
+    H = window.innerHeight;
+    canvas.width = W * dpr;
+    canvas.height = H * dpr;
+    canvas.style.width = W + 'px';
+    canvas.style.height = H + 'px';
+    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+    scale = Math.min(W, H) / 700;
+  }
+  resize();
+  window.addEventListener('resize', resize);
+
+  // State
+  var playing = true;
+  var trailsOn = true;
+  var speed = 1.0;
+  var simTime = 0;
+  var lastNow = 0;
+  var fpsCounter = 0, fpsTime = 0, fpsDisplay = 0;
+
+  // Planets
+  var orbitRadii = [62, 98, 140, 186, 246, 304];
+  var periods = [4.2, 7, 10.5, 15, 24, 36];
+  var sizes = [4.5, 6.5, 7.5, 5.5, 13, 9];
+  var colors = ['#ff9b6b', '#7be0a4', '#5fb4ff', '#e2674e', '#e6c288', '#a58bff'];
+  var moonsPerPlanet = [0, 1, 1, 2, 2, 1];
+  var phases = [];
+  for (var i = 0; i < 6; i++) phases[i] = i * 1.37 + 0.4;
+
+  var trails = [];
+  for (var i = 0; i < 6; i++) trails[i] = [];
+
+  // Moons
+  var moons = [];
+  var moonIdx = 0;
+  for (var p = 0; p < 6; p++) {
+    for (var m = 0; m < moonsPerPlanet[p]; m++) {
+      moons.push({
+        planet: p,
+        orbitR: 14 + m * 8,
+        period: 1.2 + m * 0.8,
+        size: 2 + m * 0.5,
+        phase: moonIdx * 2.1 + 0.7,
+        color: '#b0c4e8'
+      });
+      moonIdx++;
+    }
+  }
+
+  // Background stars
+  var bgStars = [];
+  for (var s = 0; s < 180; s++) {
+    var r = 0.3 + Math.random() * 1.3;
+    var base = 0.3 + Math.random() * 0.5;
+    var rate = 1 + Math.random() * 3;
+    var phase = Math.random() * Math.PI * 2;
+    var color;
+    var roll = Math.random();
+    if (roll < 0.2) color = 'rgb(255, 214, 170)';
+    else if (roll < 0.533) color = 'rgb(170, 205, 255)';
+    else color = 'rgb(255, 255, 255)';
+    bgStars.push({
+      x: Math.random(),
+      y: Math.random(),
+      r: r,
+      base: base,
+      rate: rate,
+      phase: phase,
+      color: color
+    });
+  }
+
+  // Burst particles
+  var bursts = [];
+
+  // HUD elements
+  var btnPlay = document.getElementById('btnPlay');
+  var btnTrails = document.getElementById('btnTrails');
+  var btnReset = document.getElementById('btnReset');
+  var speedSlider = document.getElementById('speed');
+  var speedVal = document.getElementById('speedVal');
+  var fpsEl = document.getElementById('fps');
+  var simTimeEl = document.getElementById('simTime');
+  var burstsEl = document.getElementById('bursts');
+
+  btnPlay.addEventListener('click', function () {
+    playing = !playing;
+    btnPlay.textContent = playing ? 'Pause' : 'Play';
+  });
+
+  btnTrails.addEventListener('click', function () {
+    trailsOn = !trailsOn;
+    btnTrails.textContent = trailsOn ? 'Trails ON' : 'Trails OFF';
+  });
+
+  btnReset.addEventListener('click', function () {
+    simTime = 0;
+    for (var i = 0; i < 6; i++) {
+      trails[i] = [];
+      phases[i] = i * 1.37 + 0.4;
+    }
+    bursts = [];
+  });
+
+  speedSlider.addEventListener('input', function (e) {
+    speed = parseFloat(e.target.value);
+    speedVal.textContent = speed.toFixed(1) + 'x';
+  });
+
+  canvas.addEventListener('click', function (e) {
+    var rect = canvas.getBoundingClientRect();
+    var cx = e.clientX - rect.left;
+    var cy = e.clientY - rect.top;
+    var count = 46 + Math.floor(Math.random() * 19);
+    for (var i = 0; i < count; i++) {
+      var angle = (i / count) * Math.PI * 2 + Math.random() * 0.1;
+      var spd = 70 + Math.random() * 210;
+      var hue = Math.random() * 360;
+      var size = 1.5 + Math.random() * 2.5;
+      var decay = 0.45 + Math.random() * 0.55;
+      bursts.push({
+        x: cx,
+        y: cy,
+        vx: Math.cos(angle) * spd,
+        vy: Math.sin(angle) * spd,
+        size: size,
+        hue: hue,
+        life: 1,
+        decay: decay
+      });
+    }
+  });
+
+  function drawStar(cx, cy, t) {
+    var coreR = 24 * scale;
+    var pulse = 1 + 0.07 * Math.sin(1.7 * t);
+    var coronaR = coreR * 5.2 * pulse;
+
+    // Corona
+    var cg = ctx.createRadialGradient(cx, cy, coreR * 0.5, cx, cy, coronaR);
+    cg.addColorStop(0, 'rgba(255, 214, 130, 0.55)');
+    cg.addColorStop(1, 'rgba(255, 214, 130, 0)');
+    ctx.fillStyle = cg;
+    ctx.beginPath();
+    ctx.arc(cx, cy, coronaR, 0, Math.PI * 2);
+    ctx.fill();
+
+    // Core
+    var sg = ctx.createRadialGradient(cx, cy, 0, cx, cy, coreR);
+    sg.addColorStop(0, '#fffbe6');
+    sg.addColorStop(0.45, '#ffd76a');
+    sg.addColorStop(1, '#ff8a2b');
+    ctx.fillStyle = sg;
+    ctx.beginPath();
+    ctx.arc(cx, cy, coreR, 0, Math.PI * 2);
+    ctx.fill();
+  }
+
+  function drawPlanet(x, y, size, color, t) {
+    var s = size * scale;
+
+    // Glow
+    var glowR = 3 * s;
+    var gg = ctx.createRadialGradient(x, y, 0, x, y, glowR);
+    gg.addColorStop(0, color + '55');
+    gg.addColorStop(1, color + '00');
+    ctx.fillStyle = gg;
+    ctx.beginPath();
+    ctx.arc(x, y, glowR, 0, Math.PI * 2);
+    ctx.fill();
+
+    // Disc
+    var dx = x - 0.35 * s;
+    var dy = y - 0.35 * s;
+    var dg = ctx.createRadialGradient(dx, dy, 0, x, y, s);
+    dg.addColorStop(0, '#ffffff');
+    dg.addColorStop(0.25, color);
+    dg.addColorStop(1, '#0a0f1f');
+    ctx.fillStyle = dg;
+    ctx.beginPath();
+    ctx.arc(x, y, s, 0, Math.PI * 2);
+    ctx.fill();
+  }
+
+  function frame(now) {
+    requestAnimationFrame(frame);
+
+    if (lastNow === 0) lastNow = now;
+    var delta = (now - lastNow) / 1000;
+    lastNow = now;
+    if (delta > 0.05) delta = 0.05;
+
+    // FPS
+    fpsCounter++;
+    fpsTime += delta;
+    if (fpsTime >= 0.5) {
+      fpsDisplay = Math.round(fpsCounter / fpsTime);
+      fpsCounter = 0;
+      fpsTime = 0;
+    }
+
+    if (playing) {
+      simTime += delta * speed;
+    }
+
+    var t = simTime;
+    var cx = W / 2;
+    var cy = H / 2;
+
+    // Clear
+    ctx.fillStyle = '#060913';
+    ctx.fillRect(0, 0, W, H);
+
+    // Background stars
+    for (var i = 0; i < bgStars.length; i++) {
+      var st = bgStars[i];
+      var alpha = st.base + 0.28 * Math.sin(t * st.rate + st.phase);
+      if (alpha < 0) alpha = 0;
+      if (alpha > 1) alpha = 1;
+      ctx.globalAlpha = alpha;
+      ctx.fillStyle = st.color;
+      ctx.beginPath();
+      ctx.arc(st.x * W, st.y * H, st.r, 0, Math.PI * 2);
+      ctx.fill();
+    }
+    ctx.globalAlpha = 1;
+
+    // Orbit ellipses
+    ctx.strokeStyle = 'rgba(130, 160, 220, 0.11)';
+    ctx.lineWidth = 1;
+    for (var i = 0; i < 6; i++) {
+      var rx = orbitRadii[i] * scale;
+      var ry = rx * 0.62;
+      ctx.beginPath();
+      ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
+      ctx.stroke();
+    }
+
+    // Trails
+    if (trailsOn) {
+      for (var i = 0; i < 6; i++) {
+        var trail = trails[i];
+        var n = trail.length;
+        if (n < 2) continue;
+        ctx.lineCap = 'round';
+        ctx.strokeStyle = colors[i];
+        for (var j = 1; j < n; j++) {
+          var idx = j;
+          ctx.lineWidth = Math.max(0.6, sizes[i] * scale * 0.42 * idx / n);
+          ctx.globalAlpha = (idx / n) * 0.55;
+          ctx.beginPath();
+          ctx.moveTo(trail[j - 1].x, trail[j - 1].y);
+          ctx.lineTo(trail[j].x, trail[j].y);
+          ctx.stroke();
+        }
+        ctx.globalAlpha = 1;
+      }
+    }
+
+    // Star
+    drawStar(cx, cy, t);
+
+    // Planets
+    for (var i = 0; i < 6; i++) {
+      var angle = phases[i] + (t / periods[i]) * Math.PI * 2;
+      var rx = orbitRadii[i] * scale;
+      var ry = rx * 0.62;
+      var px = cx + Math.cos(angle) * rx;
+      var py = cy + Math.sin(angle) * ry;
+
+      // Update trail
+      if (playing && trailsOn) {
+        trails[i].push({ x: px, y: py });
+        if (trails[i].length > 90) trails[i].shift();
+      }
+
+      drawPlanet(px, py, sizes[i], colors[i], t);
+
+      // Ring for fifth planet (index 4)
+      if (i === 4) {
+        var s = sizes[i] * scale;
+        ctx.strokeStyle = 'rgba(230, 194, 136, 0.5)';
+        ctx.lineWidth = 1.5 * scale;
+        ctx.beginPath();
+        ctx.ellipse(px, py, s * 1.8, s * 0.5, 0.3, 0, Math.PI * 2);
+        ctx.stroke();
+      }
+
+      // Moons
+      for (var m = 0; m < moons.length; m++) {
+        var mo = moons[m];
+        if (mo.planet !== i) continue;
+        var mAngle = mo.phase + (t / mo.period) * Math.PI * 2;
+        var mR = mo.orbitR * scale;
+        var mx = px + Math.cos(mAngle) * mR;
+        var my = py + Math.sin(mAngle) * mR * 0.62;
+        var ms = mo.size * scale;
+        ctx.fillStyle = mo.color;
+        ctx.beginPath();
+        ctx.arc(mx, my, ms, 0, Math.PI * 2);
+        ctx.fill();
+      }
+    }
+
+    // Burst particles
+    if (bursts.length > 0) {
+      ctx.globalCompositeOperation = 'lighter';
+      for (var i = bursts.length - 1; i >= 0; i--) {
+        var p = bursts[i];
+        if (playing) {
+          p.x += p.vx * delta;
+          p.y += p.vy * delta;
+          var damp = Math.pow(0.12, delta);
+          p.vx *= damp;
+          p.vy *= damp;
+          p.life -= p.decay * delta;
+        }
+        if (p.life <= 0) {
+          bursts.splice(i, 1);
+          continue;
+        }
+        var pr = 3 * p.size * scale;
+        var pg = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, pr);
+        pg.addColorStop(0, 'hsla(' + p.hue + ', 100%, 75%, ' + p.life + ')');
+        pg.addColorStop(1, 'hsla(' + p.hue + ', 100%, 75%, 0)');
+        ctx.fillStyle = pg;
+        ctx.beginPath();
+        ctx.arc(p.x, p.y, pr, 0, Math.PI * 2);
+        ctx.fill();
+      }
+      ctx.globalCompositeOperation = 'source-over';
+    }
+
+    // HUD updates
+    fpsEl.textContent = String(fpsDisplay);
+    simTimeEl.textContent = t.toFixed(1) + ' s';
+    burstsEl.textContent = String(bursts.length);
+  }
+
+  requestAnimationFrame(frame);
+})();
+</script>
+</body>
+</html>