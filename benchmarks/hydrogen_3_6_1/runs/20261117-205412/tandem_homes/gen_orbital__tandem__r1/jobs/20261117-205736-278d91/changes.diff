--- /dev/null
+++ b/index.html
@@ -0,0 +1,457 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Orbital Particle Simulation</title>
+<style>
+  * { margin: 0; padding: 0; box-sizing: border-box; }
+  html, body { width: 100%; height: 100%; overflow: hidden; background: #060913; }
+  #sky { display: block; width: 100vw; height: 100vh; }
+  #hud {
+    position: fixed; top: 16px; left: 16px; width: 248px;
+    background: rgba(18, 28, 54, 0.42);
+    backdrop-filter: blur(14px);
+    -webkit-backdrop-filter: blur(14px);
+    border: 1px solid rgba(140, 180, 255, 0.22);
+    border-radius: 14px;
+    padding: 14px 16px;
+    font-family: 'Segoe UI', system-ui, sans-serif;
+    color: #cdd8f5;
+    user-select: none;
+  }
+  #hud h1 {
+    font-size: 11px; font-weight: 700; letter-spacing: 2.5px;
+    text-transform: uppercase; color: #8fa8e8; margin-bottom: 10px;
+  }
+  .btn-row { display: flex; gap: 6px; margin-bottom: 10px; }
+  .btn-row button {
+    flex: 1; padding: 6px 4px; font-size: 11px; font-weight: 600;
+    white-space: nowrap;
+    background: rgba(140, 180, 255, 0.10);
+    border: 1px solid rgba(140, 180, 255, 0.25);
+    border-radius: 7px; color: #cdd8f5; cursor: pointer;
+    transition: background 0.15s;
+  }
+  .btn-row button:hover { background: rgba(140, 180, 255, 0.22); }
+  .slider-row { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
+  .slider-row label { font-size: 10px; color: #8fa8e8; white-space: nowrap; }
+  .slider-row input[type="range"] { flex: 1; accent-color: #5fb4ff; }
+  #speedVal { font-size: 11px; font-weight: 700; color: #5fb4ff; min-width: 32px; text-align: right; }
+  .readouts {
+    display: grid; grid-template-columns: 1fr 1fr; gap: 4px 10px;
+    font-variant-numeric: tabular-nums; font-size: 11px;
+  }
+  .readouts span { color: #8fa8e8; }
+  .readouts b { color: #e8eeff; font-weight: 600; }
+</style>
+</head>
+<body>
+<canvas id="sky"></canvas>
+<div id="hud">
+  <h1>Orbital Sim</h1>
+  <div class="btn-row">
+    <button id="btnPlay">Pause</button>
+    <button id="btnTrails">Trails ON</button>
+    <button id="btnReset">Reset</button>
+  </div>
+  <div class="slider-row">
+    <label for="speed">Speed</label>
+    <input type="range" id="speed" min="0.2" max="3.0" step="0.1" value="1.0">
+    <span id="speedVal">1.0x</span>
+  </div>
+  <div class="readouts">
+    <span>FPS</span><b id="fps">0</b>
+    <span>Time</span><b id="simTime">0.0 s</b>
+    <span>Bursts</span><b id="bursts">0</b>
+  </div>
+</div>
+<script>
+(function () {
+  'use strict';
+
+  var canvas = document.getElementById('sky');
+  var ctx = canvas.getContext('2d');
+  var btnPlay = document.getElementById('btnPlay');
+  var btnTrails = document.getElementById('btnTrails');
+  var btnReset = document.getElementById('btnReset');
+  var speedEl = document.getElementById('speed');
+  var speedVal = document.getElementById('speedVal');
+  var fpsEl = document.getElementById('fps');
+  var simTimeEl = document.getElementById('simTime');
+  var burstsEl = document.getElementById('bursts');
+
+  var W = 0, H = 0, dpr = 1, scale = 1;
+
+  function resize() {
+    dpr = window.devicePixelRatio || 1;
+    W = window.innerWidth;
+    H = window.innerHeight;
+    canvas.width = W * dpr;
+    canvas.height = H * dpr;
+    canvas.style.width = W + 'px';
+    canvas.style.height = H + 'px';
+    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+    scale = Math.min(W, H) / 700;
+  }
+  resize();
+  window.addEventListener('resize', resize);
+
+  // --- State ---
+  var playing = true;
+  var trailsOn = true;
+  var speed = 1.0;
+  var simT = 0;
+  var lastNow = 0;
+  var fpsCount = 0, fpsTime = 0, fpsVal = 0;
+
+  // --- Planets ---
+  var ORBIT_RADII = [62, 98, 140, 186, 246, 304];
+  var PERIODS = [4.2, 7, 10.5, 15, 24, 36];
+  var SIZES = [4.5, 6.5, 7.5, 5.5, 13, 9];
+  var COLORS = ['#ff9b6b', '#7be0a4', '#5fb4ff', '#e2674e', '#e6c288', '#a58bff'];
+  var MOON_COUNTS = [0, 1, 1, 2, 2, 1];
+  var Y_RATIO = 0.62;
+  var TRAIL_LEN = 90;
+
+  var planets = [];
+  function initPlanets() {
+    planets = [];
+    for (var i = 0; i < 6; i++) {
+      planets.push({
+        orbitR: ORBIT_RADII[i],
+        period: PERIODS[i],
+        size: SIZES[i],
+        color: COLORS[i],
+        phase: i * 1.37 + 0.4,
+        trail: []
+      });
+    }
+  }
+  initPlanets();
+
+  // --- Moons ---
+  var moons = [];
+  function initMoons() {
+    moons = [];
+    var idx = 0;
+    for (var i = 0; i < 6; i++) {
+      for (var m = 0; m < MOON_COUNTS[i]; m++) {
+        moons.push({
+          planet: i,
+          orbitR: 14 + m * 8,
+          period: 1.2 + m * 0.5,
+          size: 2.2 + m * 0.5,
+          phase: idx * 2.1 + 0.7,
+          color: '#c8d4f0'
+        });
+        idx++;
+      }
+    }
+  }
+  initMoons();
+
+  // --- Background stars ---
+  var BG_STARS = [];
+  function initBgStars() {
+    BG_STARS = [];
+    for (var i = 0; i < 180; i++) {
+      var r = 0.3 + Math.random() * 1.3;
+      var base = 0.35 + Math.random() * 0.45;
+      var rate = 1.5 + Math.random() * 3.0;
+      var phase = Math.random() * Math.PI * 2;
+      var color;
+      var roll = Math.random();
+      if (roll < 0.2) color = 'rgb(255, 214, 170)';
+      else if (roll < 0.533) color = 'rgb(170, 205, 255)';
+      else color = 'rgb(255, 255, 255)';
+      BG_STARS.push({
+        x: Math.random(),
+        y: Math.random(),
+        r: r,
+        base: base,
+        rate: rate,
+        phase: phase,
+        color: color
+      });
+    }
+  }
+  initBgStars();
+
+  // --- Burst particles ---
+  var bursts = [];
+  function spawnBurst(cx, cy) {
+    var count = 46 + Math.floor(Math.random() * 19);
+    for (var i = 0; i < count; i++) {
+      var angle = (i / count) * Math.PI * 2 + Math.random() * 0.1;
+      var spd = 70 + Math.random() * 210;
+      var hue = Math.random() * 360;
+      var size = 1.5 + Math.random() * 2.5;
+      bursts.push({
+        x: cx, y: cy,
+        vx: Math.cos(angle) * spd,
+        vy: Math.sin(angle) * spd,
+        hue: hue,
+        size: size,
+        life: 1.0,
+        decay: 0.45 + Math.random() * 0.55
+      });
+    }
+  }
+
+  // --- Drawing helpers ---
+  function drawStar(cx, cy, t) {
+    var coreR = 24 * scale;
+    var pulse = 1 + 0.07 * Math.sin(1.7 * t);
+    var coronaR = coreR * 5.2 * pulse;
+
+    // Corona
+    var cg = ctx.createRadialGradient(cx, cy, coreR * 0.5, cx, cy, coronaR);
+    cg.addColorStop(0, 'rgba(255, 214, 130, 0.55)');
+    cg.addColorStop(1, 'rgba(255, 214, 130, 0)');
+    ctx.fillStyle = cg;
+    ctx.beginPath();
+    ctx.arc(cx, cy, coronaR, 0, Math.PI * 2);
+    ctx.fill();
+
+    // Core
+    var sg = ctx.createRadialGradient(cx, cy, 0, cx, cy, coreR);
+    sg.addColorStop(0, '#fffbe6');
+    sg.addColorStop(0.45, '#ffd76a');
+    sg.addColorStop(1, '#ff8a2b');
+    ctx.fillStyle = sg;
+    ctx.beginPath();
+    ctx.arc(cx, cy, coreR, 0, Math.PI * 2);
+    ctx.fill();
+  }
+
+  function drawOrbit(cx, cy, orbitR) {
+    ctx.strokeStyle = 'rgba(130, 160, 220, 0.11)';
+    ctx.lineWidth = 1;
+    ctx.beginPath();
+    ctx.ellipse(cx, cy, orbitR * scale, orbitR * scale * Y_RATIO, 0, 0, Math.PI * 2);
+    ctx.stroke();
+  }
+
+  function drawTrail(trail, color, size) {
+    var n = trail.length;
+    if (n < 2) return;
+    ctx.lineCap = 'round';
+    ctx.strokeStyle = color;
+    for (var i = 1; i < n; i++) {
+      ctx.globalAlpha = (i / n) * 0.55;
+      ctx.lineWidth = Math.max(0.6, size * scale * 0.42 * i / n);
+      ctx.beginPath();
+      ctx.moveTo(trail[i - 1].x, trail[i - 1].y);
+      ctx.lineTo(trail[i].x, trail[i].y);
+      ctx.stroke();
+    }
+    ctx.globalAlpha = 1;
+  }
+
+  function drawPlanet(cx, cy, size, color) {
+    var s = size * scale;
+    // Glow
+    var glowR = s * 3;
+    var gg = ctx.createRadialGradient(cx, cy, 0, cx, cy, glowR);
+    gg.addColorStop(0, color + '55');
+    gg.addColorStop(1, color + '00');
+    ctx.fillStyle = gg;
+    ctx.beginPath();
+    ctx.arc(cx, cy, glowR, 0, Math.PI * 2);
+    ctx.fill();
+
+    // Disc
+    var dx = cx - 0.35 * s;
+    var dy = cy - 0.35 * s;
+    var dg = ctx.createRadialGradient(dx, dy, 0, cx, cy, s);
+    dg.addColorStop(0, '#ffffff');
+    dg.addColorStop(0.25, color);
+    dg.addColorStop(1, '#0a0f1f');
+    ctx.fillStyle = dg;
+    ctx.beginPath();
+    ctx.arc(cx, cy, s, 0, Math.PI * 2);
+    ctx.fill();
+  }
+
+  function drawRing(cx, cy, size) {
+    var s = size * scale;
+    ctx.save();
+    ctx.strokeStyle = 'rgba(230, 194, 136, 0.45)';
+    ctx.lineWidth = Math.max(1, s * 0.18);
+    ctx.beginPath();
+    ctx.ellipse(cx, cy, s * 1.9, s * 0.55, -0.35, 0, Math.PI * 2);
+    ctx.stroke();
+    ctx.restore();
+  }
+
+  function drawMoon(cx, cy, size, color) {
+    var s = size * scale;
+    ctx.fillStyle = color;
+    ctx.beginPath();
+    ctx.arc(cx, cy, s, 0, Math.PI * 2);
+    ctx.fill();
+  }
+
+  function drawBursts(dt) {
+    if (bursts.length === 0) return;
+    ctx.globalCompositeOperation = 'lighter';
+    for (var i = bursts.length - 1; i >= 0; i--) {
+      var p = bursts[i];
+      p.x += p.vx * dt;
+      p.y += p.vy * dt;
+      var damp = Math.pow(0.12, dt);
+      p.vx *= damp;
+      p.vy *= damp;
+      p.life -= p.decay * dt;
+      if (p.life <= 0) {
+        bursts.splice(i, 1);
+        continue;
+      }
+      var s = p.size * scale;
+      var r = s * 3;
+      var g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
+      g.addColorStop(0, 'hsla(' + p.hue + ', 100%, 75%, ' + p.life + ')');
+      g.addColorStop(1, 'hsla(' + p.hue + ', 100%, 75%, 0)');
+      ctx.fillStyle = g;
+      ctx.beginPath();
+      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
+      ctx.fill();
+    }
+    ctx.globalCompositeOperation = 'source-over';
+  }
+
+  // --- Main loop ---
+  function frame(now) {
+    requestAnimationFrame(frame);
+    if (lastNow === 0) lastNow = now;
+    var rawDt = (now - lastNow) / 1000;
+    lastNow = now;
+    var dt = Math.min(rawDt, 0.05);
+
+    // FPS
+    fpsCount++;
+    fpsTime += rawDt;
+    if (fpsTime >= 0.5) {
+      fpsVal = Math.round(fpsCount / fpsTime);
+      fpsCount = 0;
+      fpsTime = 0;
+    }
+
+    if (playing) {
+      simT += dt * speed;
+    }
+
+    var cx = W / 2;
+    var cy = H / 2;
+
+    // Clear
+    ctx.fillStyle = '#060913';
+    ctx.fillRect(0, 0, W, H);
+
+    // Background stars
+    for (var i = 0; i < BG_STARS.length; i++) {
+      var st = BG_STARS[i];
+      var alpha = st.base + 0.28 * Math.sin(simT * st.rate + st.phase);
+      if (alpha < 0) alpha = 0;
+      if (alpha > 1) alpha = 1;
+      ctx.globalAlpha = alpha;
+      ctx.fillStyle = st.color;
+      ctx.beginPath();
+      ctx.arc(st.x * W, st.y * H, st.r, 0, Math.PI * 2);
+      ctx.fill();
+    }
+    ctx.globalAlpha = 1;
+
+    // Orbits
+    for (var i = 0; i < 6; i++) {
+      drawOrbit(cx, cy, planets[i].orbitR);
+    }
+
+    // Star
+    drawStar(cx, cy, simT);
+
+    // Planets
+    for (var i = 0; i < 6; i++) {
+      var p = planets[i];
+      var angle = p.phase + (simT / p.period) * Math.PI * 2;
+      var px = cx + Math.cos(angle) * p.orbitR * scale;
+      var py = cy + Math.sin(angle) * p.orbitR * scale * Y_RATIO;
+
+      if (trailsOn && playing) {
+        p.trail.push({ x: px, y: py });
+        if (p.trail.length > TRAIL_LEN) p.trail.shift();
+      }
+
+      if (trailsOn) {
+        drawTrail(p.trail, p.color, p.size);
+      }
+
+      // Ring for 5th planet (index 4)
+      if (i === 4) {
+        drawRing(px, py, p.size);
+      }
+
+      drawPlanet(px, py, p.size, p.color);
+
+      // Moons
+      for (var m = 0; m < moons.length; m++) {
+        var mo = moons[m];
+        if (mo.planet !== i) continue;
+        var ma = mo.phase + (simT / mo.period) * Math.PI * 2;
+        var mx = px + Math.cos(ma) * mo.orbitR * scale;
+        var my = py + Math.sin(ma) * mo.orbitR * scale * Y_RATIO;
+        drawMoon(mx, my, mo.size, mo.color);
+      }
+    }
+
+    // Bursts
+    drawBursts(playing ? dt * speed : dt);
+
+    // HUD readouts
+    fpsEl.textContent = String(fpsVal);
+    simTimeEl.textContent = simT.toFixed(1) + ' s';
+    burstsEl.textContent = String(bursts.length);
+  }
+
+  requestAnimationFrame(frame);
+
+  // --- Events ---
+  btnPlay.addEventListener('click', function () {
+    playing = !playing;
+    btnPlay.textContent = playing ? 'Pause' : 'Play';
+  });
+
+  btnTrails.addEventListener('click', function () {
+    trailsOn = !trailsOn;
+    btnTrails.textContent = trailsOn ? 'Trails ON' : 'Trails OFF';
+    if (!trailsOn) {
+      for (var i = 0; i < planets.length; i++) planets[i].trail = [];
+    }
+  });
+
+  btnReset.addEventListener('click', function () {
+    simT = 0;
+    for (var i = 0; i < planets.length; i++) {
+      planets[i].trail = [];
+      planets[i].phase = i * 1.37 + 0.4;
+    }
+    bursts = [];
+  });
+
+  speedEl.addEventListener('input', function (e) {
+    speed = parseFloat(e.target.value);
+    speedVal.textContent = speed.toFixed(1) + 'x';
+  });
+
+  canvas.addEventListener('click', function (e) {
+    var rect = canvas.getBoundingClientRect();
+    var x = (e.clientX !== undefined ? e.clientX : e.offsetX) - rect.left;
+    var y = (e.clientY !== undefined ? e.clientY : e.offsetY) - rect.top;
+    spawnBurst(x, y);
+  });
+
+})();
+</script>
+</body>
+</html>