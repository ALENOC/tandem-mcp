; fy += f[1] * W_ALI;\n        f = steer(cx / cnt, cy / cnt, b); fx += f[0] * W_COH; fy += f[1] * W_COH;\n      }\n      if (scnt > 0) {\n        f = steer(sx, sy, b); fx += f[0] * W_SEP; fy += f[1] * W_SEP;\n      }\n      acc[i] = [fx, fy];\n    }\n    for (var k = 0; k < n; k++) {\n      var bk = boids[k];\n      bk.vx += acc[k][0] * dt; bk.vy += acc[k][1] * dt;\n      var v = limit(bk.vx, bk.vy, MAX_SPEED);\n      bk.vx = v[0]; bk.vy = v[1];\n      var sp = Math.sqrt(bk.vx * bk.vx + bk.vy * bk.vy), minS = MAX_SPEED * 0.4;\n      if (sp < minS && sp > 0) { bk.vx = bk.vx / sp * minS; bk.vy = bk.vy / sp * minS; }\n      bk.x += bk.vx * dt; bk.y += bk.vy * dt;\n      if (bk.x < 0) bk.x += width; else if (bk.x >= width) bk.x -= width;\n      if (bk.y < 0) bk.y += height; else if (bk.y >= height) bk.y -= height;\n    }\n  }\n\n  function draw() {\n    ctx.fillStyle = '#070b14';\n    ctx.fillRect(0, 0, width, height);\n    for (var i = 0; i < boids.length; i++) {\n      var b = boids[i];\n      var ang = Math.atan2(b.vy, b.vx);\n      ctx.save();\n      ctx.translate(b.x, b.y);\n      ctx.rotate(ang);\n      ctx.beginPath();\n      ctx.moveTo(9, 0);\n      ctx.lineTo(-6, 4.5);\n      ctx.lineTo(-3, 0);\n      ctx.lineTo(-6, -4.5);\n      ctx.closePath();\n      ctx.fillStyle = 'hsl(' + b.hue.toFixed(0) + ', 90%, 65%)';\n      ctx.fill();\n      ctx.restore();\n    }\n  }\n\n  function updateHud() {\n    countEl.textContent = String(boids.length);\n    speedHudEl.textContent = speed.toFixed(1) + '×';\n    speedVal.textContent = speed.toFixed(1) + '×';\n    stateEl.textContent = running ? 'In esecuzione' : 'Pausa';\n    playBtn.textContent = running ? 'Pause' : 'Play';\n    playBtn.setAttribute('aria-pressed', running ? 'true' : 'false');\n  }\n\n  // FPS measurement\n  var lastTime = performance.now();\n  var frames = 0, fpsTimer = 0;\n\n  function loop(now) {\n    var elapsed = now - lastTime;\n    lastTime = now;\n    if (!(elapsed >= 0) || elapsed > 250) elapsed = 16.67;\n    frames++; fpsTimer += elapsed;\n    if (fpsTimer >= 500) {\n      fpsEl.textContent = String(Math.round(frames * 1000 / fpsTimer));\n      frames = 0; fpsTimer = 0;\n    }\n    if (running) {\n      var dt = (elapsed / 16.67) * speed;\n      // substeps for stability at high speed\n      var steps = Math.max(1, Math.ceil(dt));\n      for (var s = 0; s < steps; s++) update(dt / steps);\n    }\n    draw();\n    requestAnimationFrame(loop);\n  }\n\n  playBtn.addEventListener('click', function () { running = !running; updateHud(); });\n  stepBtn.addEventListener('click', function () {\n    if (running) { running = false; }\n    update(speed);\n    draw();\n    updateHud();\n  });\n  resetBtn.addEventListener('click', function () {\n    running = false;\n    createFlock();\n    draw();\n    updateHud();\n  });\n  speedInput.addEventListener('input', function () {\n    var v = parseFloat(speedInput.value);\n    if (isFinite(v)) speed = Math.min(3, Math.max(0.5, v));\n    updateHud();\n  });\n  canvas.addEventListener('click', function (e) {\n    if (boids.length >= MAX_BOIDS) boids.shift();\n    var rect = canvas.getBoundingClientRect();\n    boids.push(new Boid(e.clientX - rect.left, e.clientY - rect.top));\n    draw();\n    updateHud();\n  });\n  window.addEventListener('resize', function () {\n    var ow = width || 1, oh = height || 1;\n    resize();\n    for (var i = 0; i < boids.length; i++) {\n      boids[i].x = boids[i].x / ow * width;\n      boids[i].y = boids[i].y / oh * height;\n    }\n    draw();\n  });\n\n  resize();\n  createFlock();\n  updateHud();\n  draw();\n  requestAnimationFrame(loop);\n})();\n</script>\n</body>\n</html>\n"}}},{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","resetsAt":1795290600,"rateLimitType":"five_hour","overageStatus":"rejected","overageDisabledReason":"org_level_disabled","isUsingOverage":false,"unifiedWindows":{"five_hour":{"utilization":0.2,"resetsAt":1795290600,"status":"allowed"},"seven_day":{"utiliza