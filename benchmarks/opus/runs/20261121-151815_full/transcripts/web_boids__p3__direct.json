bottom: 16px; left: 50%; transform: translateX(-50%); padding: 12px 16px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; }\n  button {\n    font: inherit; font-size: 14px; color: #e6ecff; cursor: pointer;\n    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2);\n    border-radius: 10px; padding: 8px 16px; min-width: 76px; transition: background .15s, transform .1s;\n  }\n  button:hover { background: rgba(255, 255, 255, 0.18); }\n  button:active { transform: scale(0.96); }\n  button:focus-visible, input:focus-visible { outline: 2px solid #8fd3ff; outline-offset: 2px; }\n  label { font-size: 13px; display: flex; align-items: center; gap: 8px; }\n  input[type=range] { width: 140px; accent-color: #8fd3ff; }\n  #speedVal { font-variant-numeric: tabular-nums; min-width: 38px; color: #8fd3ff; font-weight: 600; }\n  #hint { position: fixed; top: 16px; right: 16px; padding: 10px 14px; font-size: 12px; opacity: .8; user-select: none; }\n</style>\n</head>\n<body>\n<canvas id=\"canvas\" aria-label=\"Simulazione Boids\"></canvas>\n\n<div id=\"hud\" class=\"glass\" aria-live=\"polite\">\n  <h1>Boids</h1>\n  <div class=\"row\"><span>FPS</span><span id=\"fps\">0</span></div>\n  <div class=\"row\"><span>Boids</span><span id=\"count\">0</span></div>\n  <div class=\"row\"><span>Velocità</span><span id=\"speedHud\">1.0×</span></div>\n  <div class=\"row\"><span>Stato</span><span id=\"state\">Pausa</span></div>\n</div>\n\n<div id=\"hint\" class=\"glass\">Click sul canvas per aggiungere un boid</div>\n\n<div id=\"controls\" class=\"glass\">\n  <button id=\"playBtn\" type=\"button\">Play</button>\n  <button id=\"stepBtn\" type=\"button\">Step</button>\n  <button id=\"resetBtn\" type=\"button\">Reset</button>\n  <label for=\"speed\">Velocità\n    <input id=\"speed\" type=\"range\" min=\"0.5\" max=\"3.0\" step=\"0.1\" value=\"1.0\">\n    <span id=\"speedVal\">1.0×</span>\n  </label>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  var INITIAL_COUNT = 60;\n  var MAX_BOIDS = 600;\n  var PERCEPTION = 60;\n  var SEPARATION_DIST = 24;\n  var MAX_SPEED = 2.6;\n  var MAX_FORCE = 0.06;\n  var W_SEP = 1.6, W_ALI = 1.0, W_COH = 0.8;\n\n  var canvas = document.getElementById('canvas');\n  var ctx = canvas.getContext('2d');\n  var fpsEl = document.getElementById('fps');\n  var countEl = document.getElementById('count');\n  var speedHudEl = document.getElementById('speedHud');\n  var stateEl = document.getElementById('state');\n  var playBtn = document.getElementById('playBtn');\n  var stepBtn = document.getElementById('stepBtn');\n  var resetBtn = document.getElementById('resetBtn');\n  var speedInput = document.getElementById('speed');\n  var speedVal = document.getElementById('speedVal');\n\n  var width = 0, height = 0, dpr = 1;\n  var boids = [];\n  var running = false;\n  var speed = 1.0;\n\n  function resize() {\n    dpr = Math.max(1, window.devicePixelRatio || 1);\n    width = window.innerWidth;\n    height = window.innerHeight;\n    canvas.width = Math.floor(width * dpr);\n    canvas.height = Math.floor(height * dpr);\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n\n  function Boid(x, y) {\n    var a = Math.random() * Math.PI * 2;\n    var s = MAX_SPEED * (0.5 + Math.random() * 0.5);\n    this.x = x; this.y = y;\n    this.vx = Math.cos(a) * s; this.vy = Math.sin(a) * s;\n    this.hue = 190 + Math.random() * 50;\n  }\n\n  function createFlock() {\n    boids = [];\n    for (var i = 0; i < INITIAL_COUNT; i++) {\n      boids.push(new Boid(Math.random() * width, Math.random() * height));\n    }\n  }\n\n  function limit(vx, vy, max) {\n    var m2 = vx * vx + vy * vy;\n    if (m2 > max * max) { var m = Math.sqrt(m2); return [vx / m * max, vy / m * max]; }\n    return [vx, vy];\n  }\n\n  function steer(dx, dy, b) {\n    // desired velocity toward (dx,dy) at max speed, minus current velocity\n    var m = Math.sqrt(dx * dx + dy * dy);\n    if (m === 0) return [0, 0];\n    return limit(dx / m * MAX_SPEED - b.vx, dy / m * MAX_SPEED - b.vy, MAX_FORCE);\n  }\n\n  function update(dt) {\n    var n = boids.length;\n    var p2 = PERCEPTION * PERCEPTION, s2 = SEPARATION_DIST * SEPARATION_DIST;\n    var hw = width / 2, hh = height / 2;\n    var acc = new Array(n);\n    for (var i = 0; i < n; i++) {\n      var b = boids[i];\n      var sx = 0, sy = 0, ax = 0, ay = 0, cx = 0, cy = 0, cnt = 0, scnt = 0;\n      for (var j = 0; j < n; j++) {\n        if (i === j) continue;\n        var o = boids[j];\n        var dx = o.x - b.x, dy = o.y - b.y;\n        // toroidal distance\n        if (dx > hw) dx -= width; else if (dx < -hw) dx += width;\n        if (dy > hh) dy -= height; else if (dy < -hh) dy += height;\n        var d2 = dx * dx + dy * dy;\n        if (d2 < p2 && d2 > 0) {\n          ax += o.vx; ay += o.vy;\n          cx += dx; cy += dy;\n          cnt++;\n          if (d2 < s2) { sx -= dx / d2; sy -= dy / d2; scnt++; }\n        }\n      }\n      var fx = 0, fy = 0, f;\n      if (cnt > 0) {\n        f = steer(ax / cnt, ay / cnt, b); fx += f[0] * W_ALI; fy += f[1] * W_ALI;\n        f = steer(cx / cnt, cy / cnt, b); fx += f[0] * W_COH; fy += f[1] * W_COH;\n      }\n      if (scnt > 0) {\n        f = steer(sx, sy, b); fx += f[0] * W_SEP; fy += f[1] * W_SEP;\n      }\n      acc[i] = [fx, fy];\n    }\n    for (var k = 0; k < n; k++) {\n      var bk = boids[k];\n      bk.vx += acc[k][0] * dt; bk.vy += acc[k][1] * dt;\n      var v = limit(bk.vx, bk.vy, MAX_SPEED);\n      bk.vx = v[0]; bk.vy = v[1];\n      var sp = Math.sqrt(bk.vx * bk.vx + bk.vy * bk.vy), minS = MAX_SPEED * 0.4;\n      if (sp < minS && sp > 0) { bk.vx = bk.vx / sp * minS; bk.vy = bk.vy / sp * minS; }\n      bk.x += bk.vx * dt; bk.y += bk.vy * dt;\n      if (bk.x < 0) bk.x += width; else if (bk.x >= width) bk.x -= width;\n      if (bk.y < 0) bk.y += height; else if (bk.y >= height) bk.y -= height;\n    }\n  }\n\n  function draw() {\n    ctx.fillStyle = '#070b14';\n    ctx.fillRect(0, 0, width, height);\n    for (var i = 0; i < boids.length; i++) {\n      var b = boids[i];\n      var ang = Math.atan2(b.vy, b.vx);\n      ctx.save();\n      ctx.translate(b.x, b.y);\n      ctx.rotate(ang);\n      ctx.beginPath();\n      ctx.moveTo(9, 0);\n      ctx.lineTo(-6, 4.5);\n      ctx.lineTo(-3, 0);\n      ctx.lineTo(-6, -4.5);\n      ctx.closePath();\n      ctx.fillStyle = 'hsl(' + b.hue.toFixed(0) + ', 90%, 65%)';\n      ctx.fill();\n      ctx.restore();\n    }\n  }\n\n  function updateHud() {\n    countEl.textContent = String(boids.length);\n    speedHudEl.textContent = speed.toFixed(1) + '×';\n    speedVal.textContent = speed.toFixed(1) + '×';\n    stateEl.textContent = running ? 'In esecuzione' : 'Pausa';\n    playBtn.textContent = running ? 'Pause' : 'Play';\n    playBtn.setAttribute('aria-pressed', running ? 'true' : 'false');\n  }\n\n  // FPS measurement\n  var lastTime = performance.now();\n  var frames = 0, fpsTimer = 0;\n\n  function loop(now) {\n    var elapsed = now - lastTime;\n    lastTime = now;\n    if (!(elapsed >= 0) || elapsed > 250) elapsed = 16.67;\n    frames++; fpsTimer += elapsed;\n    if (fpsTimer >= 500) {\n      fpsEl.textContent = String(Math.round(frames * 1000 / fpsTimer));\n      frames = 0; fpsTimer = 0;\n    }\n    if (running) {\n      var dt = (elapsed / 16.67) * speed;\n      // substeps for stability at high speed\n      var steps = Math.max(1, Math.ceil(dt));\n      for (var s = 0; s < steps; s++) update(dt / steps);\n    }\n    draw();\n    requestAnimationFrame(loop);\n  }\n\n  playBtn.addEventListener('click', function () { running = !running; updateHud(); });\n  stepBtn.addEventListener('click', function () {\n    if (running) { running = false; }\n    update(speed);\n    draw();\n    updateHud();\n  });\n  resetBtn.addEventListener('click', function () {\n    running = false;\n    createFlock();\n    draw();\n    updateHud();\n  });\n  speedInput.addEventListener('input', function () {\n    var v = parseFloat(speedInput.value);\n    if (isFinite(v)) speed = Math.min(3, Math.max(0.5, v));\n    updateHud();\n  });\n  canvas.addEventListener('click', function (e) {\n    if (boids.length >= MAX_BOIDS) boids.shift();\n    var rect = canvas.getBoundingClientRect();\n    boids.push(new Boid(e.clientX - rect.left, e.clientY - rect.top));\n    draw();\n    updateHud();\n  });\n  window.addEventListener('resize', function () {\n    var ow = width || 1, oh = height || 1;\n    resize();\n    for (var i = 0; i < boids.length; i++) {\n      boids[i].x = boids[i].x / ow * width;\n      boids[i].y = boids[i].y / oh * height;\n    }\n    draw();\n  });\n\n  resize();\n  createFlock();\n  updateHud();\n  draw();\n  requestAnimationFrame(loop);\n})();\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1889,"cache_read_input_tokens":11720,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1889},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"402875b1-c059-4af2-b3b9-dee997e0ce59","uuid":"a3b609a5-030a-4609-89ac-fa9d8c17392a","timestamp":"2026-11-21T16:20:57.263Z","request_id":"req_011ChGNth9URLhcdF1RweWiT","wire_tool_inputs":{"toolu_014UXimaoMoLizESoEbDAyGu":{"file_path":"/home/ale/Projects/tandem-mcp/benchmarks/opus/runs/20261121-151815_full/workspaces/web_boids__p3__direct/index.html","content":"<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Boids – Simulazione di stormo</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html, body { width: 100%; height: 100%; overflow: hidden; background: #070b14; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sa