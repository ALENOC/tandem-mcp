ns: auto 1fr; gap: 4px 12px; font-size: 13px; margin-bottom: 12px; }\n  .stats dt { opacity: .65; }\n  .stats dd { font-variant-numeric: tabular-nums; text-align: right; font-weight: 600; }\n  .controls { display: flex; gap: 8px; margin-bottom: 12px; }\n  button {\n    flex: 1; padding: 7px 10px; font: inherit; font-size: 13px; font-weight: 600; color: #e6ecff;\n    background: rgba(255, 255, 255, 0.10); border: 1px solid rgba(255, 255, 255, 0.22);\n    border-radius: 10px; cursor: pointer; transition: background .15s, transform .1s;\n  }\n  button:hover { background: rgba(255, 255, 255, 0.2); }\n  button:active { transform: scale(.96); }\n  button:focus-visible, input:focus-visible { outline: 2px solid #7aa2ff; outline-offset: 2px; }\n  label { display: block; font-size: 12px; opacity: .8; margin-bottom: 4px; }\n  input[type=range] { width: 100%; accent-color: #7aa2ff; cursor: pointer; }\n  .hint { margin-top: 10px; font-size: 11px; opacity: .55; }\n</style>\n</head>\n<body>\n<canvas id=\"canvas\"></canvas>\n<div class=\"hud\" id=\"hud\">\n  <h1>Boids</h1>\n  <dl class=\"stats\">\n    <dt>FPS</dt><dd id=\"fps\">0</dd>\n    <dt>Boids</dt><dd id=\"count\">0</dd>\n    <dt>Velocità</dt><dd id=\"speedVal\">1.0×</dd>\n  </dl>\n  <div class=\"controls\">\n    <button id=\"playBtn\" type=\"button\" aria-label=\"Play\">Play</button>\n    <button id=\"stepBtn\" type=\"button\">Step</button>\n    <button id=\"resetBtn\" type=\"button\">Reset</button>\n  </div>\n  <label for=\"speed\">Velocità simulazione</label>\n  <input id=\"speed\" type=\"range\" min=\"0.5\" max=\"3.0\" step=\"0.1\" value=\"1.0\">\n  <div class=\"hint\">Click sul canvas per aggiungere un boid</div>\n</div>\n<script>\n(function () {\n  \"use strict\";\n\n  var INITIAL_COUNT = 60;\n  var MAX_SPEED = 3;\n  var MAX_FORCE = 0.06;\n  var VIEW_RADIUS = 50;\n  var SEP_RADIUS = 22;\n  var W_SEP = 1.6, W_ALI = 1.0, W_COH = 0.9;\n\n  var canvas = document.getElementById(\"canvas\");\n  var ctx = canvas.getContext(\"2d\");\n  var fpsEl = document.getElementById(\"fps\");\n  var countEl = document.getElementById(\"count\");\n  var speedValEl = document.getElementById(\"speedVal\");\n  var playBtn = document.getElementById(\"playBtn\");\n  var stepBtn = document.getElementById(\"stepBtn\");\n  var resetBtn = document.getElementById(\"resetBtn\");\n  var speedInput = document.getElementById(\"speed\");\n\n  var width = 0, height = 0, dpr = 1;\n  var boids = [];\n  var running = false;\n  var speedMul = 1.0;\n\n  function resize() {\n    dpr = Math.max(1, window.devicePixelRatio || 1);\n    width = window.innerWidth;\n    height = window.innerHeight;\n    canvas.width = Math.floor(width * dpr);\n    canvas.height = Math.floor(height * dpr);\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    draw();\n  }\n\n  function Boid(x, y) {\n    var a = Math.random() * Math.PI * 2;\n    var s = 1 + Math.random() * (MAX_SPEED - 1);\n    this.x = x; this.y = y;\n    this.vx = Math.cos(a) * s; this.vy = Math.sin(a) * s;\n    this.hue = 190 + Math.random() * 60;\n  }\n\n  function limit(vx, vy, max) {\n    var m = Math.sqrt(vx * vx + vy * vy);\n    if (m > max && m > 0) { return [vx / m * max, vy / m * max]; }\n    return [vx, vy];\n  }\n\n  function steer(dx, dy, b) {\n    var m = Math.sqrt(dx * dx + dy * dy);\n    if (m === 0) return [0, 0];\n    dx = dx / m * MAX_SPEED - b.vx;\n    dy = dy / m * MAX_SPEED - b.vy;\n    return limit(dx, dy, MAX_FORCE);\n  }\n\n  function wrapDelta(d, size) {\n    if (d > size / 2) return d - size;\n    if (d < -size / 2) return d + size;\n    return d;\n  }\n\n  function reset() {\n    boids = [];\n    var w = width || 800, h = height || 600;\n    for (var i = 0; i < INITIAL_COUNT; i++) {\n      boids.push(new Boid(Math.random() * w, Math.random() * h));\n    }\n    updateHud();\n    draw();\n  }\n\n  function update(dt) {\n    var n = boids.length, i, j;\n    var acc = new Array(n);\n    var vr2 = VIEW_RADIUS * VIEW_RADIUS, sr2 = SEP_RADIUS * SEP_RADIUS;\n    for (i = 0; i < n; i++) {\n      var b = boids[i];\n      var sx = 0, sy = 0, ax = 0, ay = 0, cx = 0, cy = 0, cnt = 0, scnt = 0;\n      for (j = 0; j < n; j++) {\n        if (i === j) continue;\n        var o = boids[j];\n        var dx = wrapDelta(o.x - b.x, width);\n        var dy = wrapDelta(o.y - b.y, height);\n        var d2 = dx * dx + dy * dy;\n        if (d2 < vr2) {\n          ax += o.vx; ay += o.vy;\n          cx += dx; cy += dy;\n          cnt++;\n          if (d2 < sr2 && d2 > 0) {\n            sx -= dx / d2; sy -= dy / d2;\n            scnt++;\n          }\n        }\n      }\n      var fx = 0, fy = 0, f;\n      if (cnt > 0) {\n        f = steer(ax / cnt, ay / cnt, b); fx += f[0] * W_ALI; fy += f[1] * W_ALI;\n        f = steer(cx / cnt, cy / cnt, b); fx += f[0] * W_COH; fy += f[1] * W_COH;\n      }\n      if (scnt > 0) {\n        f = steer(sx, sy, b); fx += f[0] * W_SEP; fy += f[1] * W_SEP;\n      }\n      acc[i] = [fx, fy];\n    }\n    for (i = 0; i < n; i++) {\n      var p = boids[i];\n      p.vx += acc[i][0] * dt; p.vy += acc[i][1] * dt;\n      var v = limit(p.vx, p.vy, MAX_SPEED);\n      p.vx = v[0]; p.vy = v[1];\n      var sp = Math.sqrt(p.vx * p.vx + p.vy * p.vy);\n      if (sp < 0.8 && sp > 0) { p.vx = p.vx / sp * 0.8; p.vy = p.vy / sp * 0.8; }\n      p.x += p.vx * dt; p.y += p.vy * dt;\n      if (p.x < 0) p.x += width; else if (p.x >= width) p.x -= width;\n      if (p.y < 0) p.y += height; else if (p.y >= height) p.y -= height;\n    }\n  }\n\n  function draw() {\n    ctx.fillStyle = \"#070b14\";\n    ctx.fillRect(0, 0, width, height);\n    for (var i = 0; i < boids.length; i++) {\n      var b = boids[i];\n      var ang = Math.atan2(b.vy, b.vx);\n      ctx.save();\n      ctx.translate(b.x, b.y);\n      ctx.rotate(ang);\n      ctx.beginPath();\n      ctx.moveTo(9, 0);\n      ctx.lineTo(-6, 4.5);\n      ctx.lineTo(-3, 0);\n      ctx.lineTo(-6, -4.5);\n      ctx.closePath();\n      ctx.fillStyle = \"hsl(\" + b.hue.toFixed(0) + \", 85%, 65%)\";\n      ctx.fill();\n      ctx.restore();\n    }\n  }\n\n  function updateHud() {\n    countEl.textContent = String(boids.length);\n    speedValEl.textContent = speedMul.toFixed(1) + \"×\";\n  }\n\n  function setRunning(r) {\n    running = r;\n    playBtn.textContent = running ? \"Pause\" : \"Play\";\n    playBtn.setAttribute(\"aria-label\", running ? \"Pause\" : \"Play\");\n  }\n\n  // FPS measurement (rAF-based, measured always)\n  var lastTime = performance.now();\n  var frames = 0, fpsAcc = 0;\n\n  function loop(now) {\n    var elapsed = now - lastTime;\n    lastTime = now;\n    if (!(elapsed >= 0)) elapsed = 16.67;\n    frames++; fpsAcc += elapsed;\n    if (fpsAcc >= 500) {\n      fpsEl.textContent = String(Math.round(frames * 1000 / fpsAcc));\n      frames = 0; fpsAcc = 0;\n    }\n    if (running) {\n      var dt = Math.min(elapsed, 50) / 16.67 * speedMul;\n      update(dt);\n      draw();\n    }\n    requestAnimationFrame(loop);\n  }\n\n  playBtn.addEventListener(\"click\", function () { setRunning(!running); });\n  stepBtn.addEventListener(\"click\", function () {\n    setRunning(false);\n    update(speedMul);\n    draw();\n  });\n  resetBtn.addEventListener(\"click\", function () {\n    setRunning(false);\n    reset();\n  });\n  speedInput.addEventListener(\"input\", function () {\n    var v = parseFloat(speedInput.value);\n    if (isFinite(v)) speedMul = Math.min(3, Math.max(0.5, v));\n    updateHud();\n  });\n  canvas.addEventListener(\"click\", function (e) {\n    var rect = canvas.getBoundingClientRect();\n    boids.push(new Boid(e.clientX - rect.left, e.clientY - rect.top));\n    updateHud();\n    draw();\n  });\n  window.addEventListener(\"resize\", resize);\n\n  resize();\n  reset();\n  setRunning(false);\n  requestAnimationFrame(loop);\n})();\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5401,"cache_read_input_t