 frame.","Full-viewport <canvas id=\"c\"> sized to window.innerWidth x innerHeight (devicePixelRatio aware), resizes on window resize; body margin 0, overflow hidden.","Background: dark radial-gradient space, center #1a0b2e fading to #05010d at edges, drawn every frame on the canvas.","Scene: two-tier platform (lower wide box, upper smaller box), twin pillars left and right, a lintel box spanning the pillar tops, and a crown cap box on top of the lintel: exactly 6 boxes x 6 faces = 36 box faces.","Box faces: dark fill (#140a24 shaded by light) with neon edge strokes in cyan #00f0ff and magenta #ff2bd6, with canvas shadowBlur glow.","Six octahedral crystals (8 triangles each = 48 triangles total) orbiting the portal at different heights, each spinning on its own axis, colors alternating cyan #00f0ff, magenta #ff2bd6, violet #9d4dff.","Portal core between the pillars: a glowing radial-gradient disc (white center to violet #9d4dff to transparent) plus two neon rings that counter-rotate (one clockwise, one counter-clockwise) drawn as projected 3D polylines.","Cyber grid floor: perspective grid lines on y=0 plane in magenta #ff2bd6 at low alpha, fading with distance.","Exactly 180 stars in a background sphere, each twinkling (alpha oscillating with its own phase and speed).","Exactly 110 particles rising from the platform around the portal, respawning at the bottom when they reach the top, additive-looking glow (globalCompositeOperation 'lighter').","Orbiting camera: circles the portal center at fixed radius and slight elevation, angle advances by dt*speed when orbit is on.","Glassmorphism HUD panel top-left: background rgba(255,255,255,0.08), backdrop-filter blur(12px), 1px border rgba(255,255,255,0.18), border-radius 14px, white/cyan text, font-family system-ui.","HUD title text exactly 'NEON PORTAL 3D'.","HUD stats: elements #fps, #polys, #parts showing labels 'FPS', 'POLYS', 'PARTS' with live values updated at least twice per second; PARTS shows 110; POLYS shows number of polygons drawn last frame.","Buttons: #btnPause text 'Pause' (toggles to 'Resume' when paused, back to 'Pause'), #btnOrbit text 'Orbit ON' (toggles to 'Orbit OFF'), #btnReset text 'Reset' (resets camera angle to 0, speed to 1, unpauses, orbit on).","Speed slider: <input type=\"range\" id=\"speed\" min=\"0\" max=\"3\" step=\"0.1\" value=\"1\"> with a label 'Speed'; changes animation speed.","When paused, the scene stops animating (time does not advance) but still renders.","Expose window.app = { paused: bool, orbit: bool, speed: number, camAngle: number, time: number, stars: array(180), particles: array(110), crystals: array(6), boxes: array(6), boxFaceCount: number(36), crystalTriCount: number(48), polysDrawn: number, frames: number }.","Use requestAnimationFrame; no console errors."],"verify_commands":["tandem:ui_test {\"steps\":[{\"exists\":\"canvas#c\"},{\"text\":\"body\",\"match\":\"NEON PORTAL 3D\"},{\"text\":\"body\",\"match\":\"FPS\"},{\"text\":\"body\",\"match\":\"POLYS\"},{\"text\":\"body\",\"match\":\"PARTS\"},{\"exists\":\"#btnPause\"},{\"exists\":\"#btnOrbit\"},{\"exists\":\"#btnReset\"},{\"exists\":\"input#speed[type=range]\"},{\"js\":\"window.app && app.stars.length===180 && app.particles.length===110 && app.crystals.length===6 && app.boxes.length===6 && app.boxFaceCount===36 && app.crystalTriCount===48\"},{\"js\":\"document.getElementById('c').width>=window.innerWidth\"},{\"wait\":800},{\"js\":\"app.frames>5 && app.polysDrawn>0\"},{\"expect\":\"moving\"},{\"click\":\"#btnOrbit\"},{\"js\":\"app.orbit===false && /Orbit OFF/.test(document.getElementById('btnOrbit').textContent)\"},{\"click\":\"#btnPause\"},{\"js\":\"app.paused===true && /Resume/.test(document.getElementById('btnPause').textContent)\"},{\"click\":\"#btnReset\"},{\"js\":\"app.paused===false && app.orbit===true && app.speed===1 && Math.abs(app.camAngle)<0.2\"}]}"]},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input