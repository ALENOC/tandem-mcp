olor: #6bffb0; }\n  #controls { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); padding: 12px 16px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; }\n  button {\n    font: inherit; font-size: 14px; font-weight: 600; color: #e6edf7; cursor: pointer;\n    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);\n    border-radius: 10px; padding: 8px 16px; min-width: 84px; transition: background .15s, transform .1s;\n  }\n  button:hover { background: rgba(143,184,255,0.25); }\n  button:active { transform: scale(0.96); }\n  button:focus-visible, input:focus-visible { outline: 2px solid #8fb8ff; outline-offset: 2px; }\n  #playBtn { background: rgba(107,255,176,0.18); border-color: rgba(107,255,176,0.45); }\n  #playBtn.playing { background: rgba(255,207,107,0.18); border-color: rgba(255,207,107,0.45); }\n  label { display: flex; align-items: center; gap: 8px; font-size: 14px; margin-left: 6px; }\n  input[type=range] { width: 140px; accent-color: #8fb8ff; }\n  #speedVal { font-variant-numeric: tabular-nums; min-width: 38px; font-weight: 600; }\n  #hint { position: fixed; top: 16px; right: 16px; padding: 10px 14px; font-size: 12px; color: #b5c3d9; user-select: none; }\n</style>\n</head>\n<body>\n<canvas id=\"canvas\" aria-label=\"Simulazione Boids\"></canvas>\n\n<div id=\"hud\" class=\"glass\" role=\"status\" aria-live=\"polite\">\n  <h1>Boids</h1>\n  <div class=\"row\"><span>FPS</span><span id=\"fps\">0</span></div>\n  <div class=\"row\"><span>Boids</span><span id=\"count\">0</span></div>\n  <div class=\"row\"><span>Velocità</span><span id=\"speedHud\">1.0×</span></div>\n  <div id=\"state\">⏸ In pausa</div>\n</div>\n\n<div id=\"hint\" class=\"glass\">Clicca sul canvas per aggiungere un boid</div>\n\n<div id=\"controls\" class=\"glass\">\n  <button id=\"playBtn\" type=\"button\" aria-label=\"Play\">▶ Play</button>\n  <button id=\"stepBtn\" type=\"button\">⏭ Step</button>\n  <button id=\"resetBtn\" type=\"button\">↺ Reset</button>\n  <label for=\"speed\">Velocità\n    <input id=\"speed\" type=\"range\" min=\"0.5\" max=\"3.0\" step=\"0.1\" value=\"1.0\">\n    <span id=\"speedVal\">1.0×</span>\n  </label>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  var INITIAL_BOIDS = 60;\n  var MAX_BOIDS = 600;\n  var PERCEPTION = 60;\n  var SEPARATION_DIST = 24;\n  var BASE_MAX_SPEED = 2.6;\n  var MAX_FORCE = 0.06;\n  var W_SEP = 1.6, W_ALI = 1.0, W_COH = 0.8;\n\n  var canvas = document.getElementById('canvas');\n  var ctx = canvas.getContext('2d');\n  var playBtn = document.getElementById('playBtn');\n  var stepBtn = document.getElementById('stepBtn');\n  var resetBtn = document.getElementById('resetBtn');\n  var speedInput = document.getElementById('speed');\n  var speedVal = document.getElementById('speedVal');\n  var fpsEl = document.getElementById('fps');\n  var countEl = document.getElementById('count');\n  var speedHud = document.getElementById('speedHud');\n  var stateEl = document.getElementById('state');\n\n  var width = 0, height = 0, dpr = 1;\n  var boids = [];\n  var running = false;\n  var speed = 1.0;\n\n  function resize() {\n    dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 2));\n    width = window.innerWidth;\n    height = window.innerHeight;\n    canvas.width = Math.floor(width * dpr);\n    canvas.height = Math.floor(height * dpr);\n    canvas.style.width = width + 'px';\n    canvas.style.height = height + 'px';\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    for (var i = 0; i < boids.length; i++) {\n      boids[i].x = Math.min(boids[i].x, width);\n      boids[i].y = Math.min(boids[i].y, height);\n    }\n    draw();\n  }\n\n  function makeBoid(x, y) {\n    var a = Math.random() * Math.PI * 2;\n    var s = BASE_MAX_SPEED * (0.5 + Math.random() * 0.5);\n    return { x: x, y: y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, hue: 190 + Math.random() * 50 };\n  }\n\n  function reset() {\n    boids = [];\n    var margin = 40;\n    for (var i = 0; i < INITIAL_BOIDS; i++) {\n      boids.push(makeBoid(\n        margin + Math.random() * Math.max(1, width - margin * 2),\n        margin + Math.random() * Math.max(1, height - margin * 2)\n      ));\n    }\n    updateHud();\n    draw();\n  }\n\n  function limit(vx, vy, max) {\n    var m2 = vx * vx + vy * vy;\n    if (m2 > max * max) {\n      var m = Math.sqrt(m2);\n      return [vx / m * max, vy / m * max];\n    }\n    return [vx, vy];\n  }\n\n  function steer(dx, dy, b, maxSpeed) {\n    var m = Math.sqrt(dx * dx + dy * dy);\n    if (m === 0) return [0, 0];\n    dx = dx / m * maxSpeed - b.vx;\n    dy = dy / m * maxSpeed - b.vy;\n    return limit(dx, dy, MAX_FORCE * speed);\n  }\n\n  function update() {\n    var maxSpeed = BASE_MAX_SPEED * speed;\n    var n = boids.length;\n    var ax = new Float32Array(n), ay = new Float32Array(n);\n    var p2 = PERCEPTION * PERCEPTION, s2 = SEPARATION_DIST * SEPARATION_DIST;\n\n    for (var i = 0; i < n; i++) {\n      var b = boids[i];\n      var sepX = 0, sepY = 0, sepN = 0;\n      var aliX = 0, aliY = 0, cohX = 0, cohY = 0, nb = 0;\n      for (var j = 0; j < n; j++) {\n        if (i === j) continue;\n        var o = boids[j];\n        var dx = o.x - b.x, dy = o.y - b.y;\n        // toroidal distance\n        if (dx > width / 2) dx -= width; else if (dx < -width / 2) dx += width;\n        if (dy > height / 2) dy -= height; else if (dy < -height / 2) dy += height;\n        var d2 = dx * dx + dy * dy;\n        if (d2 < p2 && d2 > 0) {\n          nb++;\n          aliX += o.vx; aliY += o.vy;\n          cohX += dx; cohY += dy;\n          if (d2 < s2) {\n            sepX -= dx / d2; sepY -= dy / d2; sepN++;\n          }\n        }\n      }\n      var fx = 0, fy = 0, f;\n      if (sepN > 0) { f = steer(sepX, sepY, b, maxSpeed); fx += f[0] * W_SEP; fy += f[1] * W_SEP; }\n      if (nb > 0) {\n        f = steer(aliX / nb, aliY / nb, b, maxSpeed); fx += f[0] * W_ALI; fy += f[1] * W_ALI;\n        f = steer(cohX / nb, cohY / nb, b, maxSpeed); fx += f[0] * W_COH; fy += f[1] * W_COH;\n      }\n      ax[i] = fx; ay[i] = fy;\n    }\n\n    for (var k = 0; k < n; k++) {\n      var bk = boids[k];\n      var v = limit(bk.vx + ax[k], bk.vy + ay[k], maxSpeed);\n      var sp = Math.sqrt(v[0] * v[0] + v[1] * v[1]);\n      var minSpeed = maxSpeed * 0.35;\n      if (sp < minSpeed) {\n        if (sp === 0) { v = [minSpeed, 0]; }\n        else { v = [v[0] / sp * minSpeed, v[1] / sp * minSpeed]; }\n      }\n      bk.vx = v[0]; bk.vy = v[1];\n      bk.x += bk.vx; bk.y += bk.vy;\n      if (bk.x < 0) bk.x += width; else if (bk.x >= width) bk.x -= width;\n      if (bk.y < 0) bk.y += height; else if (bk.y >= height) bk.y -= height;\n    }\n  }\n\n  function draw() {\n    ctx.fillStyle = '#070b14';\n    ctx.fillRect(0, 0, width, height);\n    for (var i = 0; i < boids.length; i++) {\n      var b = boids[i];\n      var ang = Math.atan2(b.vy, b.vx);\n      ctx.save();\n      ctx.translate(b.x, b.y);\n      ctx.rotate(ang);\n      ctx.beginPath();\n      ctx.moveTo(9, 0);\n      ctx.lineTo(-6, 4.5);\n      ctx.lineTo(-3, 0);\n      ctx.lineTo(-6, -4.5);\n      ctx.closePath();\n      ctx.fillStyle = 'hsl(' + b.hue.toFixed(0) + ', 90%, 68%)';\n      ctx.shadowColor = 'hsla(' + b.hue.toFixed(0) + ', 90%, 60%, 0.8)';\n      ctx.shadowBlur = 8;\n      ctx.fill();\n      ctx.restore();\n    }\n  }\n\n  function updateHud() {\n    countEl.textContent = String(boids.length);\n    var s = speed.toFixed(1) + '×';\n    speedHud.textContent = s;\n    speedVal.textContent = s;\n  }\n\n  function setRunning(r) {\n    running = r;\n    if (running) {\n      playBtn.textContent = '⏸ Pause';\n      playBtn.setAttribute('aria-label', 'Pause');\n      playBtn.classList.add('playing');\n      stateEl.textContent = '▶ In esecuzione';\n      stateEl.classList.add('running');\n    } else {\n      playBtn.textContent = '▶ Play';\n      playBtn.setAttribute('aria-label', 'Play');\n      playBtn.classList.remove('playing');\n      stateEl.textContent = '⏸ In pausa';\n      stateEl.classList.remove('running');\n    }\n  }\n\n  playBtn.addEventListener('click', function () { setRunning(!running); });\n  stepBtn.addEventListener('click', function () {\n    if (running) setRunning(false);\n    update(); draw();\n  });\n  resetBtn.addEventListener('click', function () { setRunning(false); reset(); });\n  speedInput.addEventListener('input', function () {\n    var v = parseFloat(speedInput.value);\n    if (!isFinite(v)) v = 1;\n    speed = Math.min(3, Math.max(0.5, v));\n    updateHud();\n  });\n  canvas.addEventListener('click', function (e) {\n    if (boids.length >= MAX_BOIDS) return;\n    var rect = canvas.getBoundingClientRect();\n    boids.push(makeBoid(e.clientX - rect.left, e.clientY - rect.top));\n    updateHud();\n    if (!running) draw();\n  });\n  window.addEventListener('keydown', function (e) {\n    if (e.target && e.target.tagName === 'INPUT') return;\n    if (e.code === 'Space') { e.preventDefault(); setRunning(!running); }\n  });\n  window.addEventListener('resize', resize);\n\n  // FPS (misurato sul rendering, anche in pausa)\n  var frames = 0, lastFpsTime = performance.now();\n  function loop(now) {\n    if (running) { update(); draw(); }\n    frames++;\n    if (now - lastFpsTime >= 500) {\n      fpsEl.textContent = String(Math.round(frames * 1000 / (now - lastFpsTime)));\n      frames = 0; lastFpsTime = now;\n    }\n    requestAnimationFrame(loop);\n  }\n\n  resize();\n  reset();\n  setRunning(false);\n  requestAnimationFrame(loop);\n})();\n</script>\n</body>\n</html>\n"}}},{"type":"rate_limit_event","rate_limit_info":{"status":"allowed_warning","resetsAt":1795554000,"rateLimitType":"five_hour","utilization":0.93,"overageStatus":"rejected","overageDisabledReason":"org_level_disabled","isUsingOverage":false,"surpassedThreshold":0.9,"unifiedWindows":{"five_hour":{"utilization":0.93,"resetsAt":1795554000,"status":"allowed_warning","surpassedThreshold":0.9},"seven_day":{"utilization":0.71,"re