\n  label { color: var(--muted); font-size: 0.9rem; display: flex; align-items: center; gap: 8px; }\n  input[type=range] { accent-color: var(--accent); width: 140px; }\n  .stats {\n    display: flex;\n    gap: 24px;\n    margin-bottom: 12px;\n    font-size: 1rem;\n  }\n  .stats span b { color: var(--accent); font-variant-numeric: tabular-nums; }\n  #status { color: var(--muted); }\n  #chart {\n    width: min(960px, 100%);\n    height: 420px;\n    background: var(--panel);\n    border-radius: 10px;\n    padding: 12px;\n    display: flex;\n    align-items: flex-end;\n    gap: 3px;\n  }\n  .bar {\n    flex: 1;\n    background: var(--bar);\n    border-radius: 3px 3px 0 0;\n    transition: background-color 0.08s;\n  }\n  .bar.compare { background: var(--compare); }\n  .bar.sorted { background: var(--sorted); }\n  .legend { display: flex; gap: 18px; margin-top: 12px; color: var(--muted); font-size: 0.9rem; }\n  .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }\n</style>\n</head>\n<body>\n  <h1>Visualizzatore di algoritmi di ordinamento</h1>\n\n  <div class=\"controls\">\n    <button id=\"playBtn\" type=\"button\">Play</button>\n    <button id=\"stepBtn\" type=\"button\">Step</button>\n    <button id=\"resetBtn\" type=\"button\">Reset</button>\n    <label>Algoritmo\n      <select id=\"algoSelect\">\n        <option value=\"bubble\">Bubble sort</option>\n        <option value=\"insertion\">Insertion sort</option>\n        <option value=\"quick\">Quick sort</option>\n      </select>\n    </label>\n    <label>Velocità\n      <input id=\"speed\" type=\"range\" min=\"1\" max=\"100\" value=\"50\">\n    </label>\n  </div>\n\n  <div class=\"stats\">\n    <span>Confronti: <b id=\"comparisons\">0</b></span>\n    <span>Scambi: <b id=\"swaps\">0</b></span>\n    <span id=\"status\">In pausa</span>\n  </div>\n\n  <div id=\"chart\"></div>\n\n  <div class=\"legend\">\n    <span><i style=\"background:var(--bar)\"></i>Non ordinata</span>\n    <span><i style=\"background:var(--compare)\"></i>A confronto</span>\n    <span><i style=\"background:var(--sorted)\"></i>Ordinata</span>\n  </div>\n\n<script>\n(function () {\n  \"use strict\";\n\n  var SIZE = 40;\n  var chart = document.getElementById(\"chart\");\n  var playBtn = document.getElementById(\"playBtn\");\n  var stepBtn = document.getElementById(\"stepBtn\");\n  var resetBtn = document.getElementById(\"resetBtn\");\n  var algoSelect = document.getElementById(\"algoSelect\");\n  var speedInput = document.getElementById(\"speed\");\n  var compEl = document.getElementById(\"comparisons\");\n  var swapEl = document.getElementById(\"swaps\");\n  var statusEl = document.getElementById(\"status\");\n\n  var arr = [];\n  var bars = [];\n  var sorted = new Set();\n  var comparing = [];\n  var comparisons = 0;\n  var swaps = 0;\n  var gen = null;\n  var running = false;\n  var finished = false;\n  var timer = null;\n\n  // ---- Algoritmi: generatori che fanno yield a ogni confronto ----\n  function compare(i, j) {\n    comparisons++;\n    comparing = [i, j];\n    return arr[i] > arr[j];\n  }\n  function swap(i, j) {\n    if (i === j) return;\n    var t = arr[i]; arr[i] = arr[j]; arr[j] = t;\n    swaps++;\n  }\n\n  function* bubbleSort() {\n    var n = arr.length;\n    for (var end = n - 1; end > 0; end--) {\n      var swapped = false;\n      for (var i = 0; i < end; i++) {\n        var gt = compare(i, i + 1);\n        yield;\n        if (gt) { swap(i, i + 1); swapped = true; }\n      }\n      sorted.add(end);\n      if (!swapped) break;\n    }\n    for (var k = 0; k < n; k++) sorted.add(k);\n  }\n\n  function* insertionSort() {\n    var n = arr.length;\n    for (var i = 1; i < n; i++) {\n      for (var j = i; j > 0; j--) {\n        var gt = compare(j - 1, j);\n        yield;\n        if (!gt) break;\n        swap(j - 1, j);\n      }\n    }\n    for (var k = 0; k < n; k++) sorted.add(k);\n  }\n\n  function* quickSort(lo, hi) {\n    if (lo > hi) return;\n    if (lo === hi) { sorted.add(lo); return; }\n    // Partizione di Lomuto con pivot = arr[hi]\n    var p = lo;\n    for (var i = lo; i < hi; i++) {\n      var gt = compare(i, hi); // arr[i] > pivot ?\n      yield;\n      if (!gt) { swap(i, p); p++; }\n    }\n    swap(p, hi);\n    sorted.add(p);\n    yield* quickSort(lo, p - 1);\n    yield* quickSort(p + 1, hi);\n  }\n\n  function makeGenerator() {\n    switch (algoSelect.value) {\n      case \"insertion\": return insertionSort();\n      case \"quick\": return (function* () {\n        yield* quickSort(0, arr.length - 1);\n        for (var k = 0; k < arr.length; k++) sorted.add(k);\n      })();\n      default: return bubbleSort();\n    }\n  }\n\n  // ---- Rendering ----\n  function buildBars() {\n    chart.innerHTML = \"\";\n    bars = [];\n    for (var i = 0; i < SIZE; i++) {\n      var b = document.createElement(\"div\");\n      b.className = \"bar\";\n      chart.appendChild(b);\n      bars.push(b);\n    }\n  }\n\n  function render() {\n    for (var i = 0; i < SIZE; i++) {\n      var b = bars[i];\n      b.style.height = arr[i] + \"%\";\n      var cls = \"bar\";\n      if (comparing.indexOf(i) !== -1) cls += \" compare\";\n      else if (sorted.has(i)) cls += \" sorted\";\n      if (b.className !== cls) b.className = cls;\n    }\n    compEl.textContent = comparisons;\n    swapEl.textContent = swaps;\n  }\n\n  function updateUI() {\n    playBtn.textContent = running ? \"Pause\" : \"Play\";\n    playBtn.disabled = finished;\n    stepBtn.disabled = finished || running;\n    statusEl.textContent = finished ? \"Completato\" : (running ? \"In esecuzione\" : \"In pausa\");\n  }\n\n  // ---- Controllo esecuzione ----\n  function step() {\n    if (finished) return;\n    if (!gen) gen = makeGenerator();\n    var res = gen.next();\n    if (res.done) {\n      finished = true;\n      comparing = [];\n      stop();\n    }\n    render();\n    updateUI();\n  }\n\n  function delay() {\n    // velocità 1 -> 500 ms, 100 -> ~5 ms\n    var v = Number(speedInput.value);\n    return Math.round(500 * Math.pow(0.01, (v - 1) / 99));\n  }\n\n  function tick() {\n    timer = null;\n    if (!running) return;\n    step();\n    if (running) timer = setTimeout(tick, delay());\n  }\n\n  function play() {\n    if (finished) return;\n    running = true;\n    updateUI();\n    tick();\n  }\n\n  function stop() {\n    running = false;\n    if (timer !== null) { clearTimeout(timer); timer = null; }\n  }\n\n  function reset() {\n    stop();\n    arr = [];\n    for (var i = 0; i < SIZE; i++) arr.push(5 + Math.floor(Math.random() * 96));\n    sorted = new Set();\n    comparing = [];\n    comparisons = 0;\n    swaps = 0;\n    gen = null;\n    finished = false;\n    render();\n    updateUI();\n  }\n\n  playBtn.addEventListener(\"click\", function () {\n    if (running) { stop(); updateUI(); } else { play(); }\n  });\n  stepBtn.addEventListener(\"click\", step);\n  resetBtn.addEventListener(\"click\", reset);\n  algoSelect.addEventListener(\"change\", reset);\n  speedInput.addEventListener(\"input\", function () {\n    if (running && timer !== null) {\n      clearTimeout(timer);\n      timer = setTimeout(tick, delay());\n    }\n  });\n\n  buildBars();\n  reset();\n})();\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3123,"cache_read_input_tokens":10596,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3123},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a810992c-888b-4755-825d-456157ac48f2","uuid":"7205f71e-61d7-4446-a3e3-1f97967bb4a5","timestamp":"2026-11-22T14:34:45.239Z","request_id":"req_011ChJ8cDH7PA9gPrFru7pRr","wire_tool_inputs":{"toolu_01TtfgwwGmuF4Tb8FWj9vseM":{"file_pat