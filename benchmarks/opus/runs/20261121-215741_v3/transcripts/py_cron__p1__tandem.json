nt < 1 o non intero.","Semantica standard: se sia giorno_mese sia giorno_settimana sono ristretti (non '*'), una data corrisponde se soddisfa UNO dei due (OR); se uno dei due è '*', vale solo l'altro.","Espressioni che non producono mai date (es. '0 0 30 2 *') devono sollevare ValueError invece di ciclare all'infinito (limite di ricerca, es. 5 anni).","test_cron_sched.py usa unittest con almeno 12 metodi test_* che coprono tutte le sintassi, OR giorno_mese/giorno_settimana, cambio mese/anno, 29 febbraio e casi ValueError."],"verify_commands":["python3 -m unittest -v test_cron_sched.py","python3 -c \"import re;s=open('test_cron_sched.py').read();n=len(re.findall(r'def test_',s));assert n>=12,n\"","python3 -c \"\nfrom datetime import datetime as D, timezone as Z\nfrom cron_sched import next_runs as N\nu=Z.utc\nassert N('*/15 * * * *',D(2024,1,1,0,0,tzinfo=u),3)==[D(2024,1,1,0,15,tzinfo=u),D(2024,1,1,0,30,tzinfo=u),D(2024,1,1,0,45,tzinfo=u)]\nassert N('0 0 1 1 *',D(2024,6,1),1)==[D(2025,1,1,tzinfo=u)]\nassert N('0 0 29 2 *',D(2024,3,1),1)==[D(2028,2,29,tzinfo=u)]\nassert N('30 9 * * 1-5',D(2024,1,5,10,0),2)==[D(2024,1,8,9,30,tzinfo=u),D(2024,1,9,9,30,tzinfo=u)]\nassert N('0 12 13 * 5',D(2024,1,1),3)==[D(2024,1,5,12,tzinfo=u),D(2024,1,12,12,tzinfo=u),D(2024,1,13,12,tzinfo=u)]\nassert N('5,10-20/5 0 * * *',D(2024,1,1),5)==[D(2024,1,1,0,m,tzinfo=u) for m in (5,10,15,20)]+[D(2024,1,2,0,5,tzinfo=u)]\nassert N('0 0 * * 7',D(2024,1,1),1)==[D(2024,1,7,tzinfo=u)]\nassert len(N('* * * * *',D(2024,1,1,0,0,30)))==5 and N('* * * * *',D(2024,1,1,0,0,30),1)==[D(2024,1,1,0,1,tzinfo=u)]\nfor b in ['','* * * *','* * * * * *','60 * * * *','* 24 * * *','* * 0 * *','* * * 13 *','* * * * 8','5-1 * * * *','*/0 * * * *','a * * * *','1,,2 * * * *','0 0 30 2 *','*/x * * * *']:\n  try: N(b,D(2024,1,1),1); raise SystemExit('no error: '+repr(b))\n  except ValueError: pass\ntry: N('* * * * *',D(2024,1,1),0); raise SystemExit('count 0')\nexcept ValueError: pass\nprint('OK')\n\""]},"caller":{"type":"