 neon portal web demo with a software 3D renderer (no WebGL, no libraries) drawing on a full-viewport 2D canvas.","workspace":"/home/ale/Projects/tandem-mcp/benchmarks/opus/runs/20261121-215741_v3/workspaces/gen_portal__p3__tandem","write_globs":["index.html","scene.js","engine3d.js","app.js"],"constraints":["Files: index.html loads engine3d.js (math, projection, painter's-algorithm triangle renderer with flat shading), scene.js (geometry builders), app.js (loop, HUD, window.app). No external network resources.","<canvas id=\"c\"> fills the full viewport (position fixed, 100vw x 100vh, resizes with window, devicePixelRatio aware); body margin 0, overflow hidden.","Background: dark radial-gradient space drawn each frame, center #1a0b3a fading to #05020f at the edges.","Two-tier platform: lower wide box and upper smaller box, cyan #00f0ff edge glow, dark faces #0d1030.","Twin pillars, a lintel across their tops and a crown cap above the lintel: total 6 boxes (2 platform tiers + 2 pillars + lintel + crown) = 36 box faces (6 faces per box). Pillars in magenta #ff2bd6 tones.","Six octahedral crystals (8 triangles each = 48 triangles) orbiting the portal, each also spinning, colors cycling cyan #00f0ff, magenta #ff2bd6, violet #9d4dff.","Portal core between the pillars: glowing radial gradient disc plus two concentric rings rotating in opposite directions (outer clockwise, inner counter-clockwise), rings drawn as projected 3D polylines with neon glow (shadowBlur).","Cyber grid floor: perspective-projected grid lines on y=0 plane in #00f0ff at low alpha, fading with distance.","Exactly 180 stars at fixed screen positions that twinkle (alpha oscillates with per-star phase).","Exactly 110 particles rising from the platform around the portal, fading out at top, respawning at the bottom.","Camera orbits the scene around the Y axis looking at the portal center when orbit is on; slight vertical bob.","HUD: glassmorphism panel top-left (background rgba(255,255,255,0.08), backdrop-filter blur(12px), 1px border rgba(255,255,255,0.18), border-radius 14px), title text exactly 'NEON PORTAL 3D' in a neon cyan glow, stat lines with ids fps, polys, parts showing 'FPS: <n>', 'POLYS: <n>', 'PARTS: <n>'.","Buttons: id btnPause with text 'Pause' (toggles to 'Play' when paused), id btnOrbit with text 'Orbit ON' (toggles to 'Orbit OFF'), id btnReset with text 'Reset' (resets camera angle to 0, speed to 1, unpause, orbit on). Slider input type range id speed min 0 max 3 step 0.1 value 1 labeled 'Speed'.","window.app = { paused:boolean, orbit:boolean, speed:number, camAngle:number, stars:Array(180), particles:Array(110), crystals:Array(6), boxFaces:number (36), crystalTris:number (48), polys:number (triangles drawn last frame), frame:number (increments each rendered frame when not paused) }.","When paused, frame and camAngle stop changing and the scene stops moving; speed multiplies all animation rates.","UI text in English."],"verify_commands":["tandem:ui_test {\"steps\":[{\"exists\":\"canvas#c\"},{\"text\":\"body\",\"match\":\"NEON PORTAL 3D\"},{\"exists\":\"#btnPause\"},{\"exists\":\"#btnOrbit\"},{\"exists\":\"#btnReset\"},{\"exists\":\"input#speed[type=range]\"},{\"wait\":800},{\"js\":\"window.app && app.stars.length===180 && app.particles.length===110 && app.crystals.length===6 && app.boxFaces===36 && app.crystalTris===48\"},{\"js\":\"app.frame>5 && app.polys>0\"},{\"text\":\"#fps\",\"match\":\"FPS: \\\\d+\"},{\"text\":\"#polys\",\"match\":\"POLYS: \\\\d+\"},{\"text\":\"#parts\",\"match\":\"PARTS: 110\"},{\"expect\":\"moving\"},{\"click\":\"#btnPause\"},{\"js\":\"app.paused===true\"},{\"expect\":\"static\"},{\"click\":\"#btnPause\"},{\"click\":\"#btnOrbit\"},{\"js\":\"app.orbit===false && /Orbit OFF/.test(document.querySelector('#btnOrbit').textContent)\"},{\"click\":\"#btnReset\"},{\"js\":\"app.orbit===true && app.paused===false && app.speed===1 && Math.abs(app.camAngle)<0.5\"}]}"]},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"st