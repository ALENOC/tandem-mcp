cron_sched.py usa unittest con almeno 12 metodi test_*."],"verify_commands":["python3 -m unittest -v test_cron_sched.py","python3 -c \"import unittest,test_cron_sched as t; n=unittest.defaultTestLoader.loadTestsFromModule(t).countTestCases(); assert n>=12, n\"","python3 -c \"\nfrom datetime import datetime, timezone as tz, timedelta\nfrom cron_sched import next_runs, parse\nU=tz.utc\nd=lambda *a: datetime(*a, tzinfo=U)\nassert next_runs('* * * * *', d(2026,1,1,0,0), 3)==[d(2026,1,1,0,1),d(2026,1,1,0,2),d(2026,1,1,0,3)]\nassert next_runs('*/15 * * * *', datetime(2026,1,1,0,7,30), 3)==[d(2026,1,1,0,15),d(2026,1,1,0,30),d(2026,1,1,0,45)]\nassert next_runs('0 0 1 1 *', d(2026,6,1), 2)==[d(2027,1,1),d(2028,1,1)]\nassert next_runs('0 0 29 2 *', d(2026,1,1), 1)==[d(2028,2,29)]\nassert next_runs('30 9 * * 1-5', d(2026,11,21,10,0), 2)==[d(2026,11,23,9,30),d(2026,11,24,9,30)]\nassert next_runs('0 12 13 * 5', d(2026,11,1), 3)==[d(2026,11,6,12),d(2026,11,13,12),d(2026,11,20,12)]\nassert next_runs('0 10-20/5 * * *', d(2026,1,1), 4)==[d(2026,1,1,10),d(2026,1,1,15),d(2026,1,1,20),d(2026,1,2,10)]\nassert next_runs('0 0 * * 0', d(2026,11,21), 1)==[d(2026,11,22)]\nr=next_runs('5,10 * * * *', datetime(2026,1,1,1,0,tzinfo=tz(timedelta(hours=2))),2); assert r==[d(2025,12,31,23,5),d(2025,12,31,23,10)], r\nassert r[0].tzinfo==U\nassert len(next_runs('* * * * *', d(2026,1,1)))==5\nassert parse('1-3,7 * * * *')[0]=={1,2,3,7}\nfor bad in ['', '* * * *', '* * * * * *', '60 * * * *', '* 24 * * *', '* * 0 * *', '* * * 13 *', '* * * * 7', '5-1 * * * *', '*/0 * * * *', 'a * * * *', '1,,2 * * * *', '*/x * * * *', '0 0 30 2 *', None]:\n    try: next_runs(bad, d(2026,1,1)); raise SystemExit('no error: %r'%bad)\n    except ValueError: pass\nprint('OK')\n\""]},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":800,"cache_read_input_tokens":14148,"cache_creation":{"ephemeral_5m_input_tokens":0